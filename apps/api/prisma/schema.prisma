// Data model for the OTP Gateway (SRS §6).
// Column names are snake_case in Postgres (@map) and camelCase in TypeScript.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Nest compiles to CommonJS, so the generated client must be CommonJS too.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("admins")
}

enum ClientStatus {
  active
  revoked

  @@map("client_status")
}

model Client {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  status          ClientStatus @default(active)
  rateLimitPerMin Int          @default(60) @map("rate_limit_per_min")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  apiKeys     ApiKey[]
  otpRequests OtpRequest[]

  @@map("clients")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  // Public part of the key, used to find the row. Unique, so it is indexed.
  prefix     String    @unique
  // SHA-256 of the full key. The key itself is never stored.
  keyHash    String    @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("api_keys")
}

enum OtpChannel {
  email
  sms

  @@map("otp_channel")
}

enum OtpStatus {
  REQUESTED
  SENT
  FAILED
  VERIFIED
  LOCKED
  EXPIRED

  @@map("otp_status")
}

enum OtpEventType {
  REQUESTED
  SENT
  FAILED
  VERIFIED
  LOCKED
  EXPIRED

  @@map("otp_event_type")
}

model OtpRequest {
  // Generated by the api (not the DB): the code hash is bound to this id before the row exists.
  id              String     @id @db.Uuid
  clientId        String     @map("client_id") @db.Uuid
  recipientMasked String     @map("recipient_masked")
  recipientHash   String     @map("recipient_hash")
  channel         OtpChannel
  purpose         String?
  status          OtpStatus  @default(REQUESTED)
  attempts        Int        @default(0)
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt      DateTime?  @map("verified_at") @db.Timestamptz(3)

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events OtpEvent[]

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@index([status, expiresAt])
  @@map("otp_requests")
}

model OtpEvent {
  // DB-side default so the worker can insert events with plain SQL.
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String       @map("request_id") @db.Uuid
  type      OtpEventType
  detail    Json?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  request OtpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("otp_events")
}
