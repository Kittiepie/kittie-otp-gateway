# Copy to .env and change the secrets. .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_USER=otp
POSTGRES_PASSWORD=otp_dev_password
POSTGRES_DB=otp_gateway
DATABASE_URL=postgresql://otp:otp_dev_password@localhost:5432/otp_gateway?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=otp
RABBITMQ_DEFAULT_PASS=otp_dev_password
RABBITMQ_URL=amqp://otp:otp_dev_password@localhost:5672

# --- SMTP (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="OTP Gateway <no-reply@otp.local>"

# --- Secrets (generate real values, e.g. `openssl rand -hex 32`) ---
OTP_HMAC_SECRET=dev-only-hmac-secret-change-me-in-prod
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod

# --- OTP policy ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Seeded admin (Phase 1) ---
ADMIN_EMAIL=admin@otp.local
ADMIN_PASSWORD=admin12345

# --- Apps ---
API_PORT=3000
API_BASE_URL=http://localhost:3000
DASHBOARD_PORT=3001
DASHBOARD_ORIGIN=http://localhost:3001
